#!/bin/sh
# novOS early start. /var/systemd/system/env/surface-manager.env, LG's own optional file
# for the environment of surface-manager-daemon.service, puts this folder first in its
# PATH. LG's surface-manager.sh calls "PmLogCtl def surface-manager" as its first
# command, before the compositor starts. That one call mounts our overlays, so the
# compositor loads them from its first start in a boot: no LG interface in between and
# no restart. Every call, that one too, ends in LG's own PmLogCtl.
#
# Without /var/lib/novos this folder is gone and PATH simply goes on to LG's folders.
HERE=/var/lib/novos/current/bin/early
if [ "${1:-}" = def ] && [ "${2:-}" = surface-manager ]; then
    early=/var/lib/novos/current/bin/novos-early.sh
    log=/var/lib/novos/state/early.log
    if [ -f "$early" ] && [ -d /var/lib/novos/state ]; then
        # The compositor waits for this, 30 s at most: early in a cold boot the CPU is
        # busy for seconds. A mount cut short is undone.
        timeout 30 sh "$early" mount </dev/null >>"$log" 2>&1 ||
            timeout 10 sh "$early" undo </dev/null >>"$log" 2>&1
    fi
fi
IFS=:
for dir in $PATH; do
    [ "$dir" != "$HERE" ] || continue
    [ -x "$dir/PmLogCtl" ] && exec "$dir/PmLogCtl" "$@"
done
exit 0
